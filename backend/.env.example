# Database configuration
# For SQLite (default): sqlite+aiosqlite:///./lazada_tracker.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/lazada_db
DATABASE_URL=sqlite+aiosqlite:///./lazada_tracker.db

# Telegram Bot configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Obtain your chat ID from @userinfobot or send a message to your bot and check getUpdates
TELEGRAM_CHAT_ID=

# Scheduler configuration (Randomized between MIN and MAX seconds)
PRICE_CHECK_MIN_INTERVAL_SECONDS=120
PRICE_CHECK_MAX_INTERVAL_SECONDS=180
PRICE_CHECK_INTERVAL_MINUTES=2

# App Configuration
APP_NAME=Lazada Price Tracker
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
