# Copy this file to /etc/lazada-tracker/lazada-tracker.env on the VPS.
# Keep the database and cookie file outside the Git checkout.
DATABASE_URL=sqlite+aiosqlite:////opt/lazada-tracker/data/lazada_tracker.db
LAZADA_COOKIE_FILE=/opt/lazada-tracker/secrets/lazada_cookies.json
LAZADA_DEBUG_DIR=/opt/lazada-tracker/data/debug/lazada
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Receive /status, /check, /products and /session without opening a public port.
TELEGRAM_COMMAND_POLLING_ENABLED=true
TELEGRAM_COMMAND_POLL_TIMEOUT_SECONDS=25
TELEGRAM_UPDATE_OFFSET_FILE=/opt/lazada-tracker/data/telegram_update_offset.json
PRICE_CHECK_MIN_INTERVAL_SECONDS=120
PRICE_CHECK_MAX_INTERVAL_SECONDS=180
PRICE_CHECK_INTERVAL_MINUTES=2
DEBUG=False
LAZADA_DEBUG=False
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
